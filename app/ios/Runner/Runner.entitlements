<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (FCM forwards to APNs). App Store export signs this as production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the share extension (ShareExtension): what other apps share into FamChat. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.famchat.app</string>
	</array>
</dict>
</plist>
