#!/bin/sh
# The AppImage's entry point (build-appimage.sh copies it in).
HERE="$(dirname "$(readlink -f "$0")")"

# libmpv plays voice and video. The video plugin links libmpv.so.1 directly, so the bundled
# libmpv (usr/lib, with the libraries it needs) must be findable at launch on systems without
# that exact version. Only the bundled libraries the system lacks go on the library path (in a
# private folder of links): libraries the system has (gnutls, cairo, GTK, ...) stay the system's,
# which the rest of the desktop stack expects.
has_lib() {
  /sbin/ldconfig -p 2>/dev/null | grep -q "^[[:space:]]*$1 " && return 0
  for d in /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib /lib64 /lib/x86_64-linux-gnu; do
    [ -e "$d/$1" ] && return 0
  done
  return 1
}
if [ -f "$HERE/usr/lib/libmpv.name" ] && ! has_lib libmpv.so.1; then
  base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
  # Folders left by runs that were killed (their process is gone).
  for old in "$base"/famchat-libs-*; do
    [ -d "$old" ] && ! kill -0 "${old##*-}" 2>/dev/null && rm -rf "$old"
  done
  libs="$base/famchat-libs-$$"
  rm -rf "$libs" && mkdir -p "$libs"
  for f in "$HERE"/usr/lib/*.so*; do
    name="$(basename "$f")"
    has_lib "$name" || ln -s "$f" "$libs/$name"
  done
  LD_LIBRARY_PATH="$libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
  # Audio loads libmpv by name: the same copy the video plugin uses.
  [ -z "$LIBMPV_LIBRARY_PATH" ] && LIBMPV_LIBRARY_PATH="$libs/$(cat "$HERE/usr/lib/libmpv.name")" && export LIBMPV_LIBRARY_PATH
  # FamChat runs as this process (exec keeps the pid): the next launch removes the folder once
  # it's gone.
fi

# Desktop integration: a launcher named after the app id (dev.famchat.app), so desktops show
# FamChat's icon on its windows and group them with the launcher. If an AppImage manager already
# made a launcher for FamChat, ours stays out of the menu. FAMCHAT_NO_DESKTOP_INTEGRATION=1 skips.
integrate() {
  data="${XDG_DATA_HOME:-$HOME/.local/share}"
  apps="$data/applications"
  icons="$data/icons/hicolor/512x512/apps"
  entry="$apps/dev.famchat.app.desktop"
  mkdir -p "$apps" "$icons" || return
  cmp -s "$HERE/dev.famchat.app.png" "$icons/dev.famchat.app.png" ||
    cp -f "$HERE/dev.famchat.app.png" "$icons/dev.famchat.app.png"
  nodisplay=false
  for f in "$apps"/*.desktop; do
    [ "$f" = "$entry" ] || [ ! -f "$f" ] && continue
    grep -qs '^StartupWMClass=dev\.famchat\.app$' "$f" && nodisplay=true && break
  done
  tmp="$entry.tmp.$$"
  {
    echo '[Desktop Entry]'
    echo 'Type=Application'
    echo 'Name=FamChat'
    echo 'Comment=Private family messenger'
    echo "Exec=\"$APPIMAGE\" %U"
    echo "TryExec=$APPIMAGE"
    echo 'Icon=dev.famchat.app'
    echo 'Categories=Network;InstantMessaging;Chat;'
    echo 'StartupWMClass=dev.famchat.app'
    echo 'Terminal=false'
    echo "NoDisplay=$nodisplay"
  } > "$tmp" || return
  if cmp -s "$tmp" "$entry"; then rm -f "$tmp"; else mv -f "$tmp" "$entry"; fi
}
if [ -n "$APPIMAGE" ] && [ -z "$FAMCHAT_NO_DESKTOP_INTEGRATION" ]; then
  integrate 2>/dev/null
fi

exec "$HERE/famchat" "$@"
