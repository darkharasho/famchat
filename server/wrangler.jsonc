{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "famchat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "famchat.dev", "custom_domain": true }],
  // The Flutter web app (`flutter build web`, copied here by scripts/deploy.sh). Paths that aren't
  // a file get index.html so go_router can handle them; /api/* always runs the Worker instead.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  // ANDROID_CERT_SHA256: Play's app-signing key (Play Console > App integrity), for Android App
  // Links (/.well-known/assetlinks.json). APPLE_APP_ID comes from the deploy (APPLE_TEAM_ID secret).
  "vars": {
    "APP_ORIGIN": "https://famchat.dev",
    "ANDROID_CERT_SHA256": "68:D1:B1:EF:42:1C:1F:13:FF:2E:0B:66:D6:66:60:D8:97:95:6D:9D:AB:69:57:14:F2:43:A5:9A:DD:A4:44:3D"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "famchat",
      "database_id": "5287eb70-0fd6-42fa-960e-0d7e99877ae9",
      "migrations_dir": "migrations"
    }
  ],
  // One FamilyHub for the whole family (idFromName("family")): WebSockets, message sequencing, events.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "FamilyHub" }] },
  "migrations": [{ "tag": "v1-hub", "new_sqlite_classes": ["FamilyHub"] }],
  // Encrypted photos, thumbnails and voice clips (ciphertext only). See src/lib/media.ts for the quota.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "famchat-media" }],
  // Push: FamilyHub queues one job per message for members with no open socket; this Worker's
  // queue() handler sends it through FCM (src/push/). Devices that failed are re-queued on their own.
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "famchat-push" }],
    "consumers": [{ "queue": "famchat-push", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 }]
  }
  // Secrets (wrangler secret put): TOKEN_SECRET, BOOTSTRAP_SECRET, and optionally FCM_SERVICE_ACCOUNT
  // (without it push is off; scripts/setup-firebase.sh sets it).
}
